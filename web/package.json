{
  "name": "intelligent-resume-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "check:draft-fields": "node --test scripts/check-draft-fields.test.mjs && node scripts/check-draft-fields.mjs",
    "lint": "eslint . --max-warnings 64",
    "lint:fix": "eslint . --fix",
    "build": "npm run check:i18n && npm run check:draft-fields && npm run check:api-unwrap && npm run check:view-states && vue-tsc -b && vite build && npm run check:bundle-budget",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "cross-env LOCAL_E2E=true playwright test --grep @local-services",
    "test:e2e:local:pdf-recovery": "cross-env LOCAL_E2E=true LOCAL_E2E_PDF_RECOVERY=true playwright test --grep \"PDF failure in the UI\"",
    "check:api-unwrap": "node scripts/check-api-unwrap.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:view-states": "node scripts/check-view-states.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "lucide-vue-next": "^0.441.0",
    "pinia": "^2.2.2",
    "vue": "^3.5.4",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/compiler-dom": "^3.5.4",
    "@vue/compiler-sfc": "^3.5.4",
    "@vue/tsconfig": "^0.5.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.2",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.4"
  }
}
