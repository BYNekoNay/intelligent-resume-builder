{
  "name": "intelligent-resume-web",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "check:draft-fields": "node --test scripts/check-draft-fields.test.mjs && node scripts/check-draft-fields.mjs",
    "build": "npm run check:i18n && npm run check:draft-fields && vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "cross-env LOCAL_E2E=true playwright test --grep @local-services",
    "test:e2e:local:pdf-recovery": "cross-env LOCAL_E2E=true LOCAL_E2E_PDF_RECOVERY=true playwright test --grep \"PDF failure in the UI\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "lucide-vue-next": "^0.441.0",
    "pinia": "^2.2.2",
    "vue": "^3.5.4",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/compiler-dom": "^3.5.4",
    "@vue/compiler-sfc": "^3.5.4",
    "@vue/tsconfig": "^0.5.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.4"
  }
}
