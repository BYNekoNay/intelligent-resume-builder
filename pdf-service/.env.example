# PDF 服务端口
PDF_SERVICE_PORT=3001

# 与后端 PDF_SERVICE_TOKEN 保持一致
PDF_SERVICE_TOKEN=dev-pdf-token-change-me

# Puppeteer / Chromium 自定义路径(可选)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Chromium 缓存目录(可选)。
# ⚠ 以 systemd 运行时必填：服务以 root 运行（HOME=/root），而部署/构建用户往往是另一个账号，
#   若用默认的 ~/.cache/puppeteer，构建期下好的浏览器运行期找不到，只在导出 PDF 时才报
#   "Could not find Chrome"。故固定为与登录用户无关的目录。
# PUPPETEER_CACHE_DIR=/opt/intelligent-resume/chromium-cache