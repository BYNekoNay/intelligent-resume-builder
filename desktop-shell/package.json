{
  "name": "intelligent-resume-desktop-shell",
  "private": true,
  "version": "0.1.0",
  "description": "智历 · Windows 桌面壳（ADR-012 阶段六）",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "stage": "node scripts/stage-jar.mjs",
    "dist": "node scripts/stage-jar.mjs && electron-builder --win nsis",
    "dist:dir": "node scripts/stage-jar.mjs && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cn.zhili.desktop",
    "productName": "Zhili",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "server",
        "filter": [
          "*.jar"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
