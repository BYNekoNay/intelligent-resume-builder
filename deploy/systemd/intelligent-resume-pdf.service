[Unit]
Description=Intelligent Resume PDF Renderer (Node.js + Puppeteer)
Documentation=file:/opt/intelligent-resume/src/docs/DEPLOYMENT_DIRECT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/intelligent-resume/app/pdf-service

# NODE_ENV=production 是必需的：src/server.js 以此决定是否强制校验 PDF_SERVICE_TOKEN，
# 缺失时会退回开发默认 token，导致 API 侧 401。
Environment=NODE_ENV=production

# 直接调用 node，不经 npm：
#   1) 避免依赖 npm 这个进程包装层（信号转发更干净、少一个进程）；
#   2) 必须写绝对路径，否则 systemd 报 status=203/EXEC。
# --env-file=.env 等价于 package.json 中 "start" 脚本的行为，Token 与端口由此注入。
# Chromium 以 root 运行时必须禁用沙箱，已由 src/browserPool.js 的 --no-sandbox 处理。
#
# ⚠ 该路径随部署主机变化，当前值对应 101.35.239.218：
#   - 旧环境（8.160.165.227）的 Node 来自另一项目的工具链，位于 /usr/local/bin/node；
#   - 新环境改用发行版包（ubuntu 的 nodejs 22.22.1），落在 /usr/bin/node。
#   要求 Node >= 20.6（依赖 --env-file）。更换 Node 安装方式时必须同步改这一行。
ExecStart=/usr/bin/node --env-file=.env src/server.js

Restart=on-failure
RestartSec=10
SuccessExitStatus=143

# 日志走 journald（自带轮转）：journalctl -u intelligent-resume-pdf -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=intelligent-resume-pdf

[Install]
WantedBy=multi-user.target
