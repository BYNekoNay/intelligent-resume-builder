# Copy outside the repository as deploy/production.env. Generate every secret with a password manager.
PUBLIC_HOST=resume.example.com
# CI/static validation may set DEPLOY_ENV_FILE=production.env.example. Keep production.env outside Git.
DEPLOY_ENV_FILE=production.env.example
MYSQL_DATABASE=intelligent_resume
MYSQL_USER=resume_app
MYSQL_PASSWORD=replace-with-at-least-16-random-characters
MYSQL_ROOT_PASSWORD=replace-with-at-least-16-random-characters
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/intelligent_resume?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=resume_app
SPRING_DATASOURCE_PASSWORD=replace-with-at-least-16-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters
PDF_SERVICE_TOKEN=replace-with-at-least-32-random-characters
BAILIAN_API_KEY=replace-with-your-bailian-key
BAILIAN_MODEL=deepseek-v3.2
CORS_ALLOWED_ORIGINS=https://resume.example.com
COOKIE_SECURE=true
PDF_SERVICE_BASE_URL=http://pdf-service:3001
PDF_OUTPUT_DIR=/var/lib/intelligent-resume/pdf-output
GRAFANA_ADMIN_PASSWORD=replace-with-at-least-16-random-characters

# --- 告警渠道（可选；仅启用 monitoring profile 时使用）---
# 钉钉/企业微信机器人 Webhook URL；留空则 webhook 通道不投递（Alertmanager 仍可启动）
ALERTMANAGER_WEBHOOK_URL=replace-with-dingtalk-or-wecom-bot-webhook-url
# SMTP 邮件告警（可选）：SMTP_USER/SMTP_PASS 可留空（部分中继无需认证）
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=alertmanager@example.com
SMTP_TO=ops@example.com
