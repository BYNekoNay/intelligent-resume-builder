# Test-only TLS endpoint for a public IP without a domain name.
#
# 安全响应头：统一由 snippets/security-headers.conf 片段下发（4 条头），
# 80 明文入口（301 跳转）与 443 TLS 入口均需 include；
# location 内若未来新增自有 add_header，必须在该 location 内再 include 一次
# （nginx 陷阱：location 内有自己的 add_header 时 server 级 add_header 全部失效）。
# ⚠ HSTS：http 明文入口加 HSTS 会被浏览器忽略甚至有害，故仅以注释形式
#   登记于 443 server（下方），TLS 正式启用且全站确认可走 https 时再取消注释。

server {
    listen 80;
    server_name _;
    # 安全响应头：301 跳转响应同样下发（无 location 块，server 级即可全覆盖）
    include snippets/security-headers.conf;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    client_max_body_size 2m;

    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # TLS 正式启用后取消下行注释（http 明文入口不加 HSTS）：
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # 安全响应头（server 级，覆盖无自有 add_header 的请求）
    include snippets/security-headers.conf;

    location / {
        include snippets/security-headers.conf; # location 级冗余 include，防未来在块内新增 add_header 后 server 级头失效
        proxy_pass http://web:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # ⚠ 最外层代理必须**覆写**（而非 $proxy_add_x_forwarded_for 追加）X-Forwarded-For：
        # 应用开启 RATE_LIMIT_TRUST_FORWARDED_HEADERS 后取最左值做限流分桶，只追加会让
        # 客户端伪造的最左值生效（绕过按 IP 限流）。契约由 DeployProxyClientIpContractTest 守护。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
