# === 后端服务端口与 CORS ===
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# === 数据库 (T01) ===
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/intelligent_resume?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=resume_app
SPRING_DATASOURCE_PASSWORD=resume_app_dev
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_JPA_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# === JWT (T02) ===
JWT_SECRET=dev-only-change-me-please-32bytes-min-length-required
JWT_ISSUER=intelligent-resume-builder
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# === 限流 (T02) ===
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=30
# 凭证变更（改密/改邮箱）：共享分桶，防口令爆破
RATE_LIMIT_CREDENTIAL=5
# 账号导出（单次重读全账号数据，低频操作）：阈值最严
RATE_LIMIT_ACCOUNT_EXPORT=3

# === AI 任务工作器 (T06) ===
AI_WORKER_POLL_MS=1000
# 租约必须 > 单任务最坏执行时长（AI 链总预算 600s），否则心跳失联期间旧 worker 仍可能被
# 接管重跑、重复调用 provider。此值须与 application.yml 的 ${AI_WORKER_LEASE_S:660} 一致。
AI_WORKER_LEASE_S=660
AI_WORKER_MAX_RETRIES=3
AI_WORKER_BATCH=5
# 已移除 AI_MOCK_FAIL_RATE / AI_MOCK_LATENCY_MS：Mock 模型不再是正常功能路径，
# 这两个键在全仓无任何消费点（改它不生效，却让人以为可开启故障模拟）。

# === PDF 导出 (T10) ===
PDF_SERVICE_BASE_URL=http://127.0.0.1:3001
PDF_SERVICE_TOKEN=dev-pdf-token-change-me
# 读超时须晚于 pdf-service 上界（排队 15s + setContent 15s + pdf 15s = 45s）：内层死线先触发
PDF_RENDER_TIMEOUT_S=50
# 输入上限：调用 pdf-service 前按序列化字节判定；输出上限：渲染结果落盘前判定
# （超出即该次导出失败、不落盘不可下载；pdf-service 侧另有 PDF_SERVICE_MAX_OUTPUT_BYTES 作第二道闸）
PDF_MAX_INPUT_BYTES=524288
PDF_MAX_OUTPUT_BYTES=10485760
PDF_FILE_TTL_HOURS=24
PDF_OUTPUT_DIR=./pdf-output

# === 数据生命周期分档清扫 (决策 D2 阶段 1) ===
# ⚠ 两条护栏默认都落在「安全侧」：关闭 + dry-run —— 即使部署也**不会**删除任何数据；
#    只有同时置 ENABLED=true 与 DRY_RUN=false 才会真正物理删除，且仅删「无任何引用者」的行。
#    被引用者转最小快照属阶段 2（未实现）。各值须与 application.yml 默认值一致。
RETENTION_PURGE_ENABLED=false
RETENTION_PURGE_DRY_RUN=true
RETENTION_PURGE_BATCH_SIZE=100
RETENTION_RECOVERY_DAYS=30
RETENTION_GRACE_DAYS=7
RETENTION_PURGE_INTERVAL_MS=21600000

